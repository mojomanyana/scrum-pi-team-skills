{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mojomanyana/scrum-pi-team-skills/schemas/spts.agent-execution-manifest/1.0.0",
  "title": "spts.agent-execution-manifest",
  "description": "Governed local Pi agent execution manifest version 1.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "executionId",
    "paca",
    "agent",
    "repository",
    "executionContext",
    "assurance",
    "resources",
    "tools",
    "piDaddyGrant",
    "delegation",
    "authorization",
    "receiptPolicy"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "executionId": { "$ref": "#/definitions/safeId" },
    "paca": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "taskId"],
      "properties": {
        "projectId": { "$ref": "#/definitions/safeId" },
        "taskId": { "$ref": "#/definitions/safeId" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": { "$ref": "#/definitions/safeName" },
        "role": {
          "enum": ["product", "flow", "principal_developer", "verifier"]
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": { "$ref": "#/definitions/absoluteWslPath" },
        "expectedGitIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "email"],
          "properties": {
            "name": { "$ref": "#/definitions/safeName" },
            "email": {
              "type": "string",
              "minLength": 3,
              "maxLength": 254,
              "pattern": "^[A-Za-z0-9.!#$%&'*+/=?^_{}~-]+@[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$"
            }
          }
        }
      }
    },
    "executionContext": {
      "$ref": "https://github.com/mojomanyana/scrum-pi-team-skills/schemas/execution-context.schema.json"
    },
    "assurance": { "enum": ["lean", "standard", "critical"] },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills", "promptTemplates"],
      "properties": {
        "skills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/skillReference" }
        },
        "promptTemplates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/promptReference" }
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["read", "bash", "edit", "write", "grep", "find", "ls"]
      }
    },
    "piDaddyGrant": {
      "type": "string",
      "minLength": 9,
      "maxLength": 127,
      "pattern": "^tool:(?:read|bash|edit|write|grep|find|ls)(?:,tool:(?:read|bash|edit|write|grep|find|ls))*$"
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxDepth"],
      "properties": { "maxDepth": { "const": 0 } }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "outOfScope",
        "outOfScopeBehavior",
        "externalEffects"
      ],
      "properties": {
        "objective": { "$ref": "#/definitions/safeProse" },
        "outOfScope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/safeProse" }
        },
        "outOfScopeBehavior": { "const": "stop-and-report" },
        "externalEffects": {
          "enum": ["prohibited", "explicit-user-approval-required"]
        }
      }
    },
    "receiptPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "includeTaskContent", "includePromptContent"],
      "properties": {
        "mode": { "const": "metadata-only" },
        "includeTaskContent": { "const": false },
        "includePromptContent": { "const": false }
      }
    }
  },
  "definitions": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "safeName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]{0,127}$"
    },
    "absoluteWslPath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^(?!.*(?:/\\.{1,2})(?:/|$))/(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"
    },
    "skillReference": {
      "type": "string",
      "minLength": 7,
      "maxLength": 70,
      "pattern": "^skill:[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "promptReference": {
      "type": "string",
      "minLength": 8,
      "maxLength": 71,
      "pattern": "^prompt:[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "safeProse": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!.*(?:\\$\\(|`|[;&|<>]|\\r|\\n|\\u0000)).*\\S.*$"
    }
  }
}
