{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrum-pi.dev/schemas/controller-store-receipt-v2.schema.json",
  "title": "Committed controller transition receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "schemaVersion",
    "algorithm",
    "algorithmVersion",
    "namespaceDigest",
    "keyId",
    "taskId",
    "projectId",
    "repositoryId",
    "runId",
    "branch",
    "candidateCommit",
    "candidateTree",
    "previousRevision",
    "committedRevision",
    "previousSnapshotDigest",
    "transitionDigest",
    "proposalDigest",
    "orderedChangesDigest",
    "orderedIntentsDigest",
    "transitionChainDigest",
    "committedSnapshotDigest",
    "operationIdentity",
    "idempotencyIdentity",
    "canonicalRequestDigest",
    "committedAt",
    "previousReceiptDigest",
    "recordDigest",
    "receiptDigest",
    "authenticationTag"
  ],
  "properties": {
    "contractId": { "const": "spts.controller-store-receipt.v2" },
    "schemaVersion": { "const": 2 },
    "algorithm": { "const": "hmac-sha256" },
    "algorithmVersion": { "const": 1 },
    "namespaceDigest": { "$ref": "#/$defs/digest" },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[\\x21-\\x7e]+$"
    },
    "taskId": { "$ref": "#/$defs/identifier" },
    "projectId": { "$ref": "#/$defs/identifier" },
    "repositoryId": { "$ref": "#/$defs/identifier" },
    "runId": { "$ref": "#/$defs/identifier" },
    "branch": { "$ref": "#/$defs/identifier" },
    "candidateCommit": { "$ref": "#/$defs/git" },
    "candidateTree": { "$ref": "#/$defs/git" },
    "previousRevision": { "$ref": "#/$defs/revision" },
    "committedRevision": { "$ref": "#/$defs/revision" },
    "previousSnapshotDigest": { "$ref": "#/$defs/digest" },
    "transitionDigest": { "$ref": "#/$defs/digest" },
    "proposalDigest": { "$ref": "#/$defs/digest" },
    "orderedChangesDigest": { "$ref": "#/$defs/digest" },
    "orderedIntentsDigest": { "$ref": "#/$defs/digest" },
    "transitionChainDigest": { "$ref": "#/$defs/digest" },
    "committedSnapshotDigest": { "$ref": "#/$defs/digest" },
    "operationIdentity": { "$ref": "#/$defs/identifier" },
    "idempotencyIdentity": {
      "type": "string",
      "pattern": "^op-[0-9a-f]{64}$"
    },
    "canonicalRequestDigest": { "$ref": "#/$defs/digest" },
    "committedAt": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
    },
    "previousReceiptDigest": { "$ref": "#/$defs/nullableDigest" },
    "recordDigest": { "$ref": "#/$defs/digest" },
    "receiptDigest": { "$ref": "#/$defs/digest" },
    "authenticationTag": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableDigest": {
      "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "git": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
