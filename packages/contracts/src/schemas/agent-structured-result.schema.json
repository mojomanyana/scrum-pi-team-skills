{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spts.agent-structured-result/2.0.0",
  "title": "Agent structured result v2",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "location", "remediation"],
      "properties": {
        "code": {
          "enum": [
            "incomplete-specification",
            "security-boundary",
            "scope-violation",
            "test-gap",
            "authority-gap"
          ]
        },
        "severity": { "enum": ["material", "advisory"] },
        "location": { "type": "string", "minLength": 1, "maxLength": 256 },
        "remediation": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandId", "outcome", "evidenceDigest"],
      "properties": {
        "commandId": {
          "enum": [
            "format-check",
            "lint",
            "typecheck",
            "test",
            "build",
            "quality"
          ]
        },
        "outcome": { "enum": ["passed", "failed"] },
        "evidenceDigest": { "$ref": "#/$defs/sha" }
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "verdict", "findingCodes"],
      "properties": {
        "axis": {
          "enum": [
            "plan-specification",
            "security",
            "correctness",
            "simplicity"
          ]
        },
        "verdict": { "enum": ["approve", "reject"] },
        "findingCodes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "enum": [
              "incomplete-specification",
              "security-boundary",
              "scope-violation",
              "test-gap",
              "authority-gap"
            ]
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "objective",
        "allowedPaths",
        "acceptanceTests",
        "dependencies"
      ],
      "properties": {
        "taskId": { "$ref": "#/$defs/id" },
        "objective": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "acceptanceTests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "dependencies": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "outcomeCode", "planDigest", "taskDefinitions"],
          "properties": {
            "kind": { "const": "product" },
            "outcomeCode": { "const": "plan-ready" },
            "planDigest": { "$ref": "#/$defs/sha" },
            "taskDefinitions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": { "$ref": "#/$defs/task" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "outcomeCode", "blocker"],
          "properties": {
            "kind": { "const": "product" },
            "outcomeCode": { "const": "stakeholder-blocked" },
            "blocker": {
              "enum": [
                "stakeholder-decision-required",
                "architecture-decision-required",
                "authority-unavailable"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "outcomeCode", "reviewedDigest", "findings"],
          "properties": {
            "kind": { "const": "flow" },
            "outcomeCode": { "enum": ["review-approved", "changes-requested"] },
            "reviewedDigest": { "$ref": "#/$defs/sha" },
            "findings": {
              "type": "array",
              "maxItems": 32,
              "items": { "$ref": "#/$defs/finding" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "outcomeCode",
            "reviewedDigest",
            "findings",
            "blocker"
          ],
          "properties": {
            "kind": { "const": "flow" },
            "outcomeCode": { "const": "authority-blocked" },
            "reviewedDigest": { "$ref": "#/$defs/sha" },
            "findings": { "type": "array", "maxItems": 0 },
            "blocker": {
              "enum": [
                "stakeholder-authority-required",
                "trusted-input-unavailable",
                "architecture-decision-required"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "outcomeCode",
            "baseCommit",
            "baseTree",
            "resultCommit",
            "resultTree",
            "changedPaths",
            "checks"
          ],
          "properties": {
            "kind": { "const": "principal-developer" },
            "outcomeCode": { "const": "implementation-ready" },
            "baseCommit": { "$ref": "#/$defs/sha1" },
            "baseTree": { "$ref": "#/$defs/sha1" },
            "resultCommit": { "$ref": "#/$defs/sha1" },
            "resultTree": { "$ref": "#/$defs/sha1" },
            "changedPaths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": { "$ref": "#/$defs/check" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "outcomeCode",
            "baseCommit",
            "changedPaths",
            "checks",
            "blocker"
          ],
          "properties": {
            "kind": { "const": "principal-developer" },
            "outcomeCode": { "const": "implementation-blocked" },
            "baseCommit": { "$ref": "#/$defs/sha1" },
            "changedPaths": { "type": "array", "maxItems": 0 },
            "checks": {
              "type": "array",
              "maxItems": 6,
              "items": { "$ref": "#/$defs/check" }
            },
            "blocker": {
              "enum": [
                "baseline-failure",
                "implementation-failure",
                "authority-unavailable",
                "path-scope-conflict"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "outcomeCode", "subjectDigest", "axes"],
          "properties": {
            "kind": { "const": "independent-verifier" },
            "outcomeCode": { "enum": ["verified", "rejected"] },
            "subjectDigest": { "$ref": "#/$defs/sha" },
            "axes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/axis" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "outcomeCode", "subjectDigest", "blocker"],
          "properties": {
            "kind": { "const": "independent-verifier" },
            "outcomeCode": { "const": "verification-blocked" },
            "subjectDigest": { "$ref": "#/$defs/sha" },
            "blocker": {
              "enum": [
                "subject-unavailable",
                "trusted-input-unavailable",
                "isolation-unavailable"
              ]
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "schemaVersion",
    "resultId",
    "resultDigest",
    "packetId",
    "packetDigest",
    "projectId",
    "taskId",
    "repositoryId",
    "runId",
    "baseBranch",
    "baseCommit",
    "baseTree",
    "headBranch",
    "candidateCommit",
    "candidateTree",
    "role",
    "actorId",
    "executionId",
    "workspaceId",
    "access",
    "assurance",
    "authorityDigest",
    "controllerStateDigest",
    "status",
    "payload"
  ],
  "properties": {
    "contractId": { "const": "spts.agent-structured-result" },
    "schemaVersion": { "const": "2.0.0" },
    "resultId": { "$ref": "#/$defs/id" },
    "resultDigest": { "$ref": "#/$defs/sha" },
    "packetId": { "$ref": "#/$defs/id" },
    "packetDigest": { "$ref": "#/$defs/sha" },
    "projectId": { "$ref": "#/$defs/id" },
    "taskId": { "$ref": "#/$defs/id" },
    "repositoryId": { "$ref": "#/$defs/id" },
    "runId": { "$ref": "#/$defs/id" },
    "baseBranch": { "type": "string", "minLength": 1, "maxLength": 255 },
    "baseCommit": { "$ref": "#/$defs/sha1" },
    "baseTree": { "$ref": "#/$defs/sha1" },
    "headBranch": { "type": "string", "minLength": 1, "maxLength": 255 },
    "candidateCommit": { "$ref": "#/$defs/sha1" },
    "candidateTree": { "$ref": "#/$defs/sha1" },
    "role": {
      "enum": ["product", "flow", "principal-developer", "independent-verifier"]
    },
    "actorId": { "$ref": "#/$defs/id" },
    "executionId": { "$ref": "#/$defs/id" },
    "workspaceId": { "$ref": "#/$defs/id" },
    "access": { "$ref": "#/$defs/id" },
    "assurance": { "enum": ["lean", "standard", "critical"] },
    "authorityDigest": { "$ref": "#/$defs/sha" },
    "controllerStateDigest": { "$ref": "#/$defs/sha" },
    "status": {
      "enum": [
        "planned",
        "blocked",
        "accepted",
        "changes-requested",
        "completed",
        "approved",
        "rejected"
      ]
    },
    "payload": { "$ref": "#/$defs/payload" }
  }
}
